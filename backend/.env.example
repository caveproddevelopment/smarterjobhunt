DATABASE_URL=postgresql://smarterjobhunt:devpassword@localhost:5432/smarterjobhunt
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:5000
TOKEN_MAX_AGE_SECONDS=1209600

# Email verification
EMAIL_VERIFICATION_MAX_AGE_SECONDS=300

# Password reset
PASSWORD_RESET_MAX_AGE_SECONDS=300

# Google Apps Script web app that sends verification/reset emails via Gmail.
# No shared secret is sent — this URL IS the credential, keep it private.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXX/exec

# Stripe billing — create one Product with one weekly recurring Price in the
# Stripe Dashboard and paste its ID below. Webhook secret
# comes from the endpoint's signing secret (or `stripe listen` locally).
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXX
STRIPE_PRICE_WEEKLY=price_XXXXXXXXXX
# Stripe Billing Portal configuration that only allows card updates and
# cancellation; do not enable subscription plan switching in this configuration.
STRIPE_PORTAL_CONFIGURATION=bpc_XXXXXXXXXX
